// References between the resources in the Sam's FHIR journey answer
// (resource-examples/R5/sam-fhir-journey/Bundle.json), FHIR R5.
// Render with: dot -Tpng patient-fhir-journey-exersize-r5.gv -o patient-fhir-journey-exersize-r5.png
digraph g {
  rankdir = TB
  graph [fontname="Helvetica", nodesep=0.35, ranksep=0.55, pad=0.2]
  node [fontname="Helvetica", fontsize=13]
  edge [fontname="Helvetica", fontsize=12]
  "Patient" [style="filled", fillcolor="lightgrey"]
  "Appointment" -> "Patient" [label="participant.actor"]
  "Encounter" -> "Patient" [label="subject"]
  "Encounter" -> "Practitioner" [label="participant.actor"]
  "Encounter" -> "Appointment" [label="appointment"]
  "Encounter" -> "Organization (hospital)" [label="serviceProvider"]
  "AllergyIntolerance" -> "Patient" [label="patient"]
  "AllergyIntolerance" -> "Practitioner" [label="participant.actor"]
  "ServiceRequest" -> "Patient" [label="subject"]
  "ServiceRequest" -> "Encounter" [label="encounter"]
  "ServiceRequest" -> "Practitioner" [label="requester"]
  "ServiceRequest" -> "Organization (pathlab)" [label="performer"]
  "Task" -> "Practitioner" [label="requester"]
  "Task" -> "ServiceRequest" [label="input"]
  "Task" -> "DiagnosticReport" [label="output"]
  "DiagnosticReport" -> "Patient" [label="subject"]
  "DiagnosticReport" -> "Organization (pathlab)" [label="performer"]
  "DiagnosticReport" -> "ServiceRequest" [label="basedOn"]
  "DiagnosticReport" -> "Observation" [label="result"]
  "Observation" -> "Patient" [label="subject"]
  "Observation" -> "Organization (pathlab)" [label="performer"]
}
